# Copy to `.env` and fill in. Nothing here is secret by default — the SQLite
# fallback needs no configuration at all.

# Local development (default): file-backed SQLite, zero setup.
# DATABASE_URL=sqlite+aiosqlite:///./fogline.db

# Hosted Postgres (Neon): paste the connection string from the dashboard as-is.
# The app normalizes the scheme to asyncpg and strips libpq-only query args
# (sslmode / channel_binding), so no hand-editing is needed.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/fogline

# Signing key for the device session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=change-me
